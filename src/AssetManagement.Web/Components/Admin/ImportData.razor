@page "/import"
@attribute [Authorize]
@rendermode InteractiveServer

@using AssetManagement.Application.Interfaces.Assets
@using AssetManagement.Application.Interfaces.Assignments
@using AssetManagement.Application.Interfaces.Employees
@using AssetManagement.Application.Interfaces.Data
@using AssetManagement.Application.Interfaces.Agent
@using AssetManagement.Application.Services
@using Microsoft.AspNetCore.Components.Forms

@inject ExcelImportService Importer
@inject IEmployeeService EmployeeService
@inject IAssetService AssetService

<h2>Bulk Import (Excel)</h2>

<p class="text-muted">
    Upload a <code>.xlsx</code> file to seed many records at once.
    The first row must be column headers.
</p>

<div class="mb-3">
    <label class="form-label">What are you importing?</label>
    <div>
        <label class="me-3">
            <input type="radio" name="importType" checked="@(Type == ImportKind.Employees)"
                   @onchange="() => Type = ImportKind.Employees" /> Employees
        </label>
        <label>
            <input type="radio" name="importType" checked="@(Type == ImportKind.Assets)"
                   @onchange="() => Type = ImportKind.Assets" /> Assets
        </label>
    </div>
    <small class="text-muted">Required columns: <code>@ExpectedColumns()</code></small>
</div>

<div class="mb-3">
    <InputFile OnChange="OnFileSelected" accept=".xlsx,.csv" class="form-control" />
</div>

<button class="btn btn-primary" @onclick="RunImport" disabled="@(_file is null || _busy)">
    @(_busy ? "Importing..." : "Import")
</button>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_errors.Count == 0 ? "alert-success" : "alert-warning") mt-3">@_message</div>
}

@if (_errors.Count > 0)
{
    <h4>Skipped rows</h4>
    <table class="table table-sm">
        <thead><tr><th>Row</th><th>Problem</th></tr></thead>
        <tbody>
            @foreach (ImportRowError err in _errors)
            {
                <tr><td>@err.Row</td><td>@err.Message</td></tr>
            }
        </tbody>
    </table>
}

@code {
    private enum ImportKind { Employees, Assets }

    private ImportKind Type { get; set; } = ImportKind.Employees;
    private IBrowserFile? _file;
    private bool _busy;
    private string _message = string.Empty;
    private List<ImportRowError> _errors = new List<ImportRowError>();

    private const long MaxBytes = 20 * 1024 * 1024; // 20 MB

    private string ExpectedColumns() => Type == ImportKind.Employees
        ? "FullName, Email, PhoneNumber, Department, Designation"
        : "AssetName, SerialNumber, Type, PurchaseDate, WarrantyExpiryDate, Condition";

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _file = e.File;
        _message = string.Empty;
        _errors = new List<ImportRowError>();
    }

    private async Task RunImport()
    {
        if (_file is null) return;
        _busy = true;
        _message = string.Empty;
        _errors = new List<ImportRowError>();
        try
        {
            using var memory = new MemoryStream();
            await _file.OpenReadStream(MaxBytes).CopyToAsync(memory);
            memory.Position = 0;

            int imported;
            int total;
            if (Type == ImportKind.Employees)
            {
                var result = Importer.ParseEmployees(memory, _file.Name);
                var validationResult = await EmployeeService.ValidateImportAsync(result.Valid);
                _errors = result.Errors.Concat(validationResult.Errors).ToList();
                await EmployeeService.CreateBulkEmployeesAsync(validationResult.ValidEmployees);
                imported = validationResult.ValidEmployees.Count;
                total = result.TotalRows;
            }
            else
            {
                var result = Importer.ParseAssets(memory, _file.Name);
                var validationResult = await AssetService.ValidateImportAsync(result.Valid);
                _errors = result.Errors.Concat(validationResult.Errors).ToList();
                await AssetService.CreateAssetsAsync(validationResult.ValidAssets);
                imported = validationResult.ValidAssets.Count;
                total = result.TotalRows;
            }

            _message = $"Imported {imported} of {total} row(s). {_errors.Count} skipped.";
        }
        catch (Exception ex)
        {
            _message = $"Import failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}

