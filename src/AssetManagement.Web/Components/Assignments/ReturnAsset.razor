@page "/assets/return/{assetId:int}"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using AssetManagement.Domain.Entities
@using AssetManagement.Application.Interfaces.Assets
@using AssetManagement.Application.Interfaces.Assignments
@using AssetManagement.Application.Interfaces.Employees

@inject IAssetService AssetService
@inject IAssetAssignmentService AssetAssignmentService

@inject IEmployeeService EmployeeService
@inject NavigationManager Navigation

<h2>Return Asset :</h2>
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}
@if (SelectedAsset is not null)
{
    <table class="table">
        <thead>
            <tr>
                <th>Asset Name</th>
                <th>Serial Number</th>
                <th>Purchase Date</th>
                <th>Warranty Expiry Date</th>
                <th>Assigned Employee</th>
                <th>Assignment Date</th>
                <th>Condition</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td>@SelectedAsset.AssetName</td>
                <td>@SelectedAsset.SerialNumber</td>
                <td>@SelectedAsset.PurchaseDate.ToString(format: "dd-MM-yyyy")</td>
                <td>@SelectedAsset.WarrantyExpiryDate.ToString(format: "dd-MM-yyyy")</td>
                <td>@AssignedEmployee?.FullName</td>
                <td>@SelectedAssignment?.AssignmentDate.ToString(format: "dd-MM-yyyy")</td>
                <td>@SelectedAsset.Condition</td>
            </tr>
        </tbody>
    </table>
}
else
{
    <p>No asset selected.</p>
}
@if (SelectedAssignment is not null)
{
    <EditForm Model="SelectedAssignment" FormName="ReturnAsset" OnValidSubmit="ReturnAssignment">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <p class="text-warning">
                Confirm to return this asset :
            </p>
        </div>
        <button type="submit" class="btn btn-primary">Return Asset</button>
        <span class="mx-1"> | </span>
        <NavLink class="btn btn-secondary" href="@($"/assets")">
            Cancel
        </NavLink>
    </EditForm>
}
else
{
    <p>No active assignment found for this asset.</p>
}


@code {
    [Parameter] public int assetId { get; set; }

    private Asset? SelectedAsset;
    private AssetAssignment? SelectedAssignment;

    private Employee? AssignedEmployee;

    private string ErrorMessage { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            SelectedAsset = await AssetService.GetAssetByIdOrThrowAsync(assetId);
        }
        catch (ArgumentException)
        {
            Navigation.NavigateTo(uri: "/assets");
            return;
        }
        try
        {
            SelectedAssignment = await AssetAssignmentService.GetActiveAssignmentByAssetIdAsync(assetId);

            AssignedEmployee = await EmployeeService.GetEmployeeByIdOrThrowAsync(SelectedAssignment!.EmployeeId);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            ErrorMessage = "No active assignment found for this asset.";
            return;
        }
    }

    private async Task ReturnAssignment()
    {
        try
        {
            await AssetAssignmentService.ReturnAssetAsync(SelectedAssignment!.Id);
            Navigation.NavigateTo(uri: "/assets");
        }
        catch (InvalidOperationException ex)
        {
            ErrorMessage = ex.Message;
        }
        catch (Exception)
        {
            ErrorMessage = "An unexpected error occurred while returning the asset. Please try again.";
        }
    }
}


