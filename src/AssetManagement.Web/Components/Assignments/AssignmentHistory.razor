@page "/assignments"
@attribute [Authorize]
@rendermode InteractiveServer
@using AssetManagement.Application.DTOs
@using AssetManagement.Application.DTOs.AssignmentDTOs
@using AssetManagement.Application.Interfaces.Assignments
@using AssetManagement.Domain.Enums.Assignments

@inject IAssetAssignmentService AssetAssignmentService

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Asset Assignment History</h2>
    <p class="text-muted mb-0">
        View all current and previous asset assignments.
    </p>
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    @if (SelectedAssignmentDetails != null)
    {
        <div class="mb-4">
            <button class="btn btn-outline-secondary" @onclick="() => SelectedAssignmentDetails = null">
                <i class="bi bi-arrow-left"></i> Back to History
            </button>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Assignment Details</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Asset Info -->
                    <div class="col-md-6 mb-4">
                        <h6 class="text-muted border-bottom pb-2 mb-3">Asset Information</h6>
                        <dl class="row">
                            <dt class="col-sm-4">Name</dt>
                            <dd class="col-sm-8">@SelectedAssignmentDetails.AssetName</dd>

                            <dt class="col-sm-4">Serial Number</dt>
                            <dd class="col-sm-8">@SelectedAssignmentDetails.SerialNumber</dd>

                            <dt class="col-sm-4">Type</dt>
                            <dd class="col-sm-8">@SelectedAssignmentDetails.AssetType</dd>

                            <dt class="col-sm-4">Condition</dt>
                            <dd class="col-sm-8">@SelectedAssignmentDetails.AssetCondition</dd>
                        </dl>
                    </div>

                    <!-- Employee Info -->
                    <div class="col-md-6 mb-4">
                        <h6 class="text-muted border-bottom pb-2 mb-3">Employee Information</h6>
                        <dl class="row">
                            <dt class="col-sm-4">Employee No.</dt>
                            <dd class="col-sm-8">@SelectedAssignmentDetails.EmployeeNumber</dd>

                            <dt class="col-sm-4">Name</dt>
                            <dd class="col-sm-8">@SelectedAssignmentDetails.EmployeeName</dd>

                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">@SelectedAssignmentDetails.EmployeeEmail</dd>

                            <dt class="col-sm-4">Department</dt>
                            <dd class="col-sm-8">@SelectedAssignmentDetails.EmployeeDepartment</dd>

                            <dt class="col-sm-4">Designation</dt>
                            <dd class="col-sm-8">@SelectedAssignmentDetails.EmployeeDesignation</dd>
                        </dl>
                    </div>

                    <!-- Assignment Info -->
                    <div class="col-12">
                        <h6 class="text-muted border-bottom pb-2 mb-3">Assignment History</h6>
                        <dl class="row">
                            <dt class="col-sm-2">Assigned On</dt>
                            <dd class="col-sm-10">@SelectedAssignmentDetails.AssignedDate.ToString("dd MMM yyyy")</dd>

                            <dt class="col-sm-2">Returned On</dt>
                            <dd class="col-sm-10">@(SelectedAssignmentDetails.ReturnedDate?.ToString("dd MMM yyyy") ?? "Currently Assigned")</dd>

                            <dt class="col-sm-2">Status</dt>
                            <dd class="col-sm-10">
                                @if (SelectedAssignmentDetails.IsReturned)
                                {
                                    <span class="badge bg-success">Returned</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Active</span>
                                }
                            </dd>

                        </dl>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Filters Card -->
        <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <label class="form-label">Search Field</label>
                    <InputSelect @bind-Value="Query.SearchField" class="form-select">
                        <option value="@AssignmentSearchField.AssetName">Asset Name</option>
                        <option value="@AssignmentSearchField.AssignedEmployeeName">Employee Name</option>
                    </InputSelect>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Search Term</label>
                    <InputText @bind-Value="Query.SearchTerm" placeholder="Search..." class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <InputSelect @bind-Value="Query.ReturnStatus" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="false">Active (Assigned)</option>
                        <option value="true">Returned</option>
                    </InputSelect>
                </div>
            </div>
            
            <div class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label">Assign From</label>
                    <InputDate @bind-Value="Query.AssignmentDateFrom" TValue="DateOnly?" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Assign To</label>
                    <InputDate @bind-Value="Query.AssignmentDateTo" TValue="DateOnly?" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Return From</label>
                    <InputDate @bind-Value="Query.ReturnDateFrom" TValue="DateOnly?" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Return To</label>
                    <InputDate @bind-Value="Query.ReturnDateTo" TValue="DateOnly?" class="form-control" />
                </div>
                <div class="col-md-4 d-flex">
                    <button class="btn btn-primary w-100 me-2" @onclick="SearchFilterAsync">Filter</button>
                    <button class="btn btn-outline-secondary w-100" @onclick="ResetAsync">Reset</button>
                </div>
            </div>
        </div>
    </div>

    @if (!PagedAssignments.Items.Any())
    {
        <div class="empty-state shadow-sm">
            <h4>No assignment history found</h4>
            <p>Try adjusting your filters.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-bold">Assignments List</span>
                <span class="text-muted small">Showing @PagedAssignments.Items.Count() of @PagedAssignments.TotalCount assignments</span>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <button class="btn btn-link text-decoration-none p-0 text-dark fw-bold"
                                        @onclick="() => SortAsync(AssignmentSortField.AssetName)">
                                    Asset Name @GetSortIcon(AssignmentSortField.AssetName)
                                </button>
                            </th>
                            <th>Serial Number</th>
                            <th>Assigned Employee</th>
                            <th>
                                <button class="btn btn-link text-decoration-none p-0 text-dark fw-bold"
                                        @onclick="() => SortAsync(AssignmentSortField.AssignmentDate)">
                                    Assignment Date @GetSortIcon(AssignmentSortField.AssignmentDate)
                                </button>
                            </th>
                            <th>
                                <button class="btn btn-link text-decoration-none p-0 text-dark fw-bold"
                                        @onclick="() => SortAsync(AssignmentSortField.ReturnDate)">
                                    Return Date @GetSortIcon(AssignmentSortField.ReturnDate)
                                </button>
                            </th>
                            <th>Details</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (AssetAssignmentHistoryDto assignment in PagedAssignments.Items)
                        {
                            <tr>
                                <td class="align-middle">@assignment.AssetName</td>
                                <td class="align-middle text-muted">@assignment.SerialNumber</td>
                                <td class="align-middle">@assignment.EmployeeName</td>
                                <td class="align-middle">@assignment.AssignedDate.ToString("dd-MM-yyyy")</td>
                                <td class="align-middle">
                                    @(assignment.ReturnedDate?.ToString("dd-MM-yyyy") ?? "—")
                                </td>
                                <td class="align-middle">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => SelectedAssignmentDetails = assignment">
                                        View Details
                                    </button>
                                </td>
                                <td class="align-middle">
                                    @if (assignment.IsReturned)
                                    {
                                        <span class="badge bg-success">Returned</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Assigned</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (PagedAssignments.TotalPages > 1)
            {
                <div class="card-footer bg-white d-flex justify-content-center">
                    <ul class="pagination mb-0">
                        <li class="page-item @(PagedAssignments.PageNumber == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="PreviousPage">Previous</button>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">Page @PagedAssignments.PageNumber of @PagedAssignments.TotalPages</span>
                        </li>
                        <li class="page-item @(PagedAssignments.PageNumber == PagedAssignments.TotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="NextPage">Next</button>
                        </li>
                    </ul>
                </div>
            }
        </div>
    }
    }
}

@code {
    private bool isLoading = true;
    private AssetAssignmentHistoryDto? SelectedAssignmentDetails { get; set; }
    private PagedResultDto<AssetAssignmentHistoryDto> PagedAssignments { get; set; } = new PagedResultDto<AssetAssignmentHistoryDto>();
    private AssignmentQueryDto Query { get; set; } = new AssignmentQueryDto();
    private string ErrorMessage { get; set; } = string.Empty;

    private async Task LoadAssignmentsAsync()
    {
        try
        {
            PagedAssignments = await AssetAssignmentService.GetAssetAssignmentHistoryAsync(Query);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An unexpected error occurred while loading the assignments: {ex.Message}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await LoadAssignmentsAsync();
        isLoading = false;
    }

    private async Task PreviousPage()
    {
        if (PagedAssignments.PageNumber > 1)
        {
            isLoading = true;
            Query.PageNumber--;
            await LoadAssignmentsAsync();
            isLoading = false;
        }
    }

    private async Task NextPage()
    {
        if (PagedAssignments.PageNumber < PagedAssignments.TotalPages)
        {
            isLoading = true;
            Query.PageNumber++;
            await LoadAssignmentsAsync();
            isLoading = false;
        }
    }

    private async Task SearchFilterAsync()
    {
        isLoading = true;
        Query.PageNumber = 1;
        await LoadAssignmentsAsync();
        isLoading = false;
    }

    private async Task SortAsync(AssignmentSortField sortField)
    {
        isLoading = true;
        Query.PageNumber = 1;
        if (Query.SortField == sortField)
        {
            Query.SortDirection = (Query.SortDirection == SortDirection.Ascending) ? SortDirection.Descending : SortDirection.Ascending;
        }
        else
        {
            Query.SortField = sortField;
            Query.SortDirection = SortDirection.Ascending;
        }
        await LoadAssignmentsAsync();
        isLoading = false;
    }

    private string GetSortIcon(AssignmentSortField field)
    {
        if (Query.SortField == field)
        {
            return Query.SortDirection == SortDirection.Ascending ? "▲" : "▼";
        }
        return string.Empty;
    }

    private async Task ResetAsync()
    {
        isLoading = true;
        Query = new AssignmentQueryDto();
        await LoadAssignmentsAsync();
        isLoading = false;
    }
}

