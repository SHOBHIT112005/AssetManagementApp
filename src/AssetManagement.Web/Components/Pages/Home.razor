@page "/"

@attribute [Authorize]
@using AssetManagement.Application.Interfaces.Assets
@using AssetManagement.Application.Interfaces.Employees
@using AssetManagement.Application.DTOs
@using AssetManagement.Application.DTOs.AssetDTOs
@using AssetManagement.Application.DTOs.EmployeeDTOs
@inject IAssetService AssetService
@inject IEmployeeService EmployeeService

<PageTitle>Admin Dashboard | Asset Management</PageTitle>

<header class="header">
    <div class="header-title">
        <h1>Admin Dashboard</h1>
        <p>@DateTime.Today.ToString("dddd, MMMM d, yyyy")</p>
    </div>
    
    <div class="profile-area">
        <div class="avatar">AD</div>
        <span style="font-weight: 600;">Admin User</span>
    </div>
</header>

<section class="banner">
    <div class="banner-content">
        <h2>Hi, Admin User</h2>
        <p>Ready to manage your organization's assets seamlessly?</p>
    </div>
    <img src="images/file.svg" class="banner-illustration" alt="Hero Illustration" />
</section>

<h3 class="section-title">Overview</h3>
<section class="stats-grid">
    <div class="stat-card c-yellow">
        <h3>@AssetSummary.TotalAssets</h3>
        <p>Total Assets</p>
    </div>
    <div class="stat-card c-teal">
        <h3>@AssignedRate</h3>
        <p>Assigned Rate</p>
    </div>
    <div class="stat-card c-pink">
        <h3>@AssetSummary.UnderRepairAssets</h3>
        <p>Under Repair</p>
    </div>
    <div class="stat-card c-dark">
        <h3>@EmployeeSummary.ActiveEmployees</h3>
        <p>Active Employees</p>
    </div>
</section>

<h3 class="section-title">Core Features</h3>
<section class="features-grid">
    
    <div class="feature-card">
        <div class="feature-icon">🔍</div>
        <div class="feature-content">
            <h4>Smart Asset Tracking</h4>
            <p>Keep a real-time inventory of all laptops, monitors, and peripherals.<br>Instantly locate who has what and their condition.</p>
        </div>
        <div class="feature-tick">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#00B4B6" viewBox="0 0 16 16">
              <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
            </svg>
        </div>
    </div>

    <div class="feature-card">
        <div class="feature-icon">🤖</div>
        <div class="feature-content">
            <h4>AI-Powered Natural Language Queries</h4>
            <p>Don't want to use complex filters? Just ask the AI Agent:<br>"Show me all laptops assigned to the HR department."</p>
        </div>
        <div class="feature-tick">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#00B4B6" viewBox="0 0 16 16">
              <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
            </svg>
        </div>
    </div>

    <div class="feature-card">
        <div class="feature-icon">🔄</div>
        <div class="feature-content">
            <h4>Lifecycle & Assignments</h4>
            <p>Easily onboard new employees by assigning them standard hardware.<br>Track warranties and retire broken devices.</p>
        </div>
        <div class="feature-tick">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#00B4B6" viewBox="0 0 16 16">
              <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
            </svg>
        </div>
    </div>

</section>

@code {
    private AssetSummaryDto AssetSummary = new();
    private EmployeeSummaryDto EmployeeSummary = new();
    private string AssignedRate = "0%";

    protected override async Task OnInitializedAsync()
    {
        AssetSummary = await AssetService.GetAssetSummaryServiceAsync(new AssetQueryDto());
        EmployeeSummary = await EmployeeService.GetEmployeeSummaryServiceAsync(new EmployeeQueryDto());
        
        if (AssetSummary.TotalAssets > 0)
        {
            var rate = (int)Math.Round((double)AssetSummary.AssignedAssets / AssetSummary.TotalAssets * 100);
            AssignedRate = $"{rate}%";
        }
    }
}
