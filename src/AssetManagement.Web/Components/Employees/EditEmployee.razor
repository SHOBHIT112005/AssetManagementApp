@page "/employees/edit/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using AssetManagement.Application.Interfaces.Employees
@using AssetManagement.Domain.Entities
@using AssetManagement.Domain.Enums.Employees
@using Microsoft.AspNetCore.Components.Forms

@inject IEmployeeService EmployeeService

@inject NavigationManager Navigation


<div class="app-form-container">
<div class="app-form-header">
    <h2>Edit Employee</h2>
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}
@if (employee == null)
{
    <p>Loading employee details, please wait....</p>
}
else if (employee.Status == EmployeeStatus.Inactive)
{
    <div class="app-form-card">
        <div class="alert alert-warning">
            This employee is deactivated and cannot be edited. Reactivate the employee first to make changes.
        </div>
        <button type="button" class="btn btn-outline-secondary px-4" @onclick='() => Navigation.NavigateTo("/employees")'>
            Back to Employees
        </button>
    </div>
}
else
{
    <div class="app-form-card">
        <EditForm Model="employee" OnValidSubmit="UpdateEmployee" FormName="EditEmployee">
            <DataAnnotationsValidator />

            <div class="app-form-section">
                <div class="app-form-section-header">Personal Information</div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="fullName" class="app-form-label">
                            Full Name <span class="text-danger">*</span>
                        </label>
                        <InputText id="fullName" class="form-control app-form-control" @bind-Value="employee.FullName" />
                        <ValidationMessage For="@(() => employee.FullName)" class="app-form-validation" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="email" class="app-form-label">
                            Email <span class="text-danger">*</span>
                        </label>
                        <InputText id="email" class="form-control app-form-control" @bind-Value="employee.Email" />
                        <ValidationMessage For="@(() => employee.Email)" class="app-form-validation" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="phoneNumber" class="app-form-label">
                            Phone Number <span class="text-danger">*</span>
                        </label>
                        <InputText id="phoneNumber" class="form-control app-form-control" @bind-Value="employee.PhoneNumber" />
                        <ValidationMessage For="@(() => employee.PhoneNumber)" class="app-form-validation" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="dateOfBirth" class="app-form-label">
                            Date of Birth
                        </label>
                        <InputDate id="dateOfBirth" class="form-control app-form-control" @bind-Value="employee.DateOfBirth" />
                        <ValidationMessage For="@(() => employee.DateOfBirth)" class="app-form-validation" />
                    </div>
                </div>
            </div>

            <div class="app-form-section">
                <div class="app-form-section-header">Employment Details</div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="department" class="app-form-label">
                            Department <span class="text-danger">*</span>
                        </label>
                        <InputSelect id="department" class="form-select app-form-control" @bind-Value="employee.Department">
                            <option value="">-- Select Department --</option>
                            @foreach (Department department in Enum.GetValues<Department>())
                            {
                                <option value="@department">@department</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => employee.Department)" class="app-form-validation" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="designation" class="app-form-label">
                            Designation <span class="text-danger">*</span>
                        </label>
                        <InputSelect id="designation" class="form-select app-form-control" @bind-Value="employee.Designation">
                            <option value="">-- Select Designation --</option>
                            @foreach (EmployeeDesignation designation in Enum.GetValues<EmployeeDesignation>())
                            {
                                <option value="@designation">@designation</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => employee.Designation)" class="app-form-validation" />
                    </div>
                </div>
            </div>

            <div class="app-form-actions">
                <button type="submit" class="btn btn-primary px-4" disabled="@_saving">
                    Update Employee
                </button>
                <button type="button" class="btn btn-outline-secondary px-4" @onclick='() => Navigation.NavigateTo("/employees")'>
                    Cancel
                </button>
            </div>
        </EditForm>
    </div>
}
</div>

@code {
    [Parameter]
    public int Id { get; set; }
    private Employee? employee;
    private string ErrorMessage { get; set; } = string.Empty;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            employee = await EmployeeService.GetEmployeeByIdOrThrowAsync(Id);
        }
        catch (ArgumentException)
        {
            Navigation.NavigateTo(uri: "/employees");
        }
    }

    private async Task UpdateEmployee()
    {
        if (_saving) return;
        _saving = true;
        try
        {
            await EmployeeService.UpdateEmployeeAsync(employee!);
            Navigation.NavigateTo(uri: "/employees");
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An unexpected error occurred while updating the employee: {ex.Message}";
            @* Console.WriteLine(value: $"An unexpected error occurred while updating the employee: {ex.Message}"); *@
        }
        finally
        {
            _saving = false;
        }
    }
}

