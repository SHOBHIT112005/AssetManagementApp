@page "/assets/create"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using AssetManagement.Domain.Entities
@using AssetManagement.Application.Interfaces.Assets
@using AssetManagement.Domain.Enums.Assets
@using Microsoft.AspNetCore.Components.Forms

@inject NavigationManager Navigation
@inject IAssetService AssetService

<div class="app-form-container">
<div class="app-form-header">
    <h2>Create Asset</h2>
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

<div class="app-form-card">
    <EditForm Model="NewAsset" OnValidSubmit="SaveAsset" FormName="CreateAsset">
        <DataAnnotationsValidator />

        <div class="app-form-section">
            <div class="app-form-section-header">Detail</div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="fullName" class="app-form-label">
                        Asset Name <span class="text-danger">*</span>
                    </label>
                    <InputText id="fullName" class="form-control app-form-control" @bind-Value="NewAsset.AssetName" placeholder="Enter asset name" />
                    <ValidationMessage For="@(() => NewAsset.AssetName)" class="app-form-validation" />
                </div>

                <div class="col-md-6 mb-3">
                    <label for="serialNumber" class="app-form-label">
                        Serial Number <span class="text-danger">*</span>
                    </label>
                    <InputText id="serialNumber" class="form-control app-form-control" @bind-Value="NewAsset.SerialNumber" placeholder="Enter serial number" />
                    <ValidationMessage For="@(() => NewAsset.SerialNumber)" class="app-form-validation" />
                </div>

                <div class="col-md-6 mb-3">
                    <label for="assetType" class="app-form-label">
                        Asset Type <span class="text-danger">*</span>
                    </label>
                    <InputSelect id="assetType" class="form-select app-form-control" @bind-Value="NewAsset.Type">
                        <option value="">-- Select Asset Type --</option>
                        @foreach (AssetType type in Enum.GetValues<AssetType>())
                        {
                            <option value="@type">@type</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => NewAsset.Type)" class="app-form-validation" />
                </div>
            </div>
        </div>

        <div class="app-form-section">
            <div class="app-form-section-header">Condition & Warranty</div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="app-form-label">Purchase Date</label>
                    <InputDate @bind-Value="NewAsset.PurchaseDate" TValue="DateOnly" class="form-control app-form-control" min="2010-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="app-form-label">Warranty Expiry Date</label>
                    <InputDate @bind-Value="NewAsset.WarrantyExpiryDate" TValue="DateOnly" class="form-control app-form-control" min="2010-01-01" max="2040-12-31" />
                </div>

                <div class="col-md-6 mb-3">
                    <label for="assetCondition" class="app-form-label">
                        Asset Condition <span class="text-danger">*</span>
                    </label>
                    <InputSelect id="assetCondition" class="form-select app-form-control" @bind-Value="NewAsset.Condition">
                        <option value="">-- Select Asset Condition --</option>
                        @foreach (AssetCondition condition in Enum.GetValues<AssetCondition>())
                        {
                            <option value="@condition">@condition</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => NewAsset.Condition)" class="app-form-validation" />
                </div>
            </div>
        </div>

        <div class="app-form-actions">
            <button type="submit" class="btn btn-primary px-4" disabled="@_saving">
                Save Asset
            </button>
            <button type="button" class="btn btn-outline-secondary px-4" @onclick='() => Navigation.NavigateTo("/assets")'>
                Cancel
            </button>
        </div>
    </EditForm>
</div>
</div>

@code {
    private string ErrorMessage { get; set; } = string.Empty;
    private bool _saving;
    private Asset NewAsset = new Asset
    {
        PurchaseDate = DateOnly.FromDateTime(DateTime.Today),
        WarrantyExpiryDate = DateOnly.FromDateTime(DateTime.Today.AddYears(value: 3))
    };

    private async Task SaveAsset()
    {
        if (_saving) return;
        _saving = true;
        ErrorMessage = string.Empty;
        if (NewAsset.WarrantyExpiryDate <= NewAsset.PurchaseDate)
        {
            ErrorMessage = "Warranty expiry date must be strictly after the purchase date.";
            _saving = false;
            return;
        }
        try
        {
            await AssetService.CreateAssetAsync(NewAsset);
            Navigation.NavigateTo("/assets");
        }
        catch (ArgumentException ex)
        {
            ErrorMessage = ex.Message;
        }
        catch (Exception)
        {
            ErrorMessage = "An error occurred while creating the asset. Please try again.";
        }
        finally
        {
            _saving = false;
        }
    }
}

