@page "/assets/create"
@attribute [Authorize]
@rendermode InteractiveServer
@using AssetManagement.Domain.Entities
@using AssetManagement.Application.Interfaces.Assets
@using AssetManagement.Application.Interfaces.Assignments
@using AssetManagement.Application.Interfaces.Employees
@using AssetManagement.Application.Interfaces.Data
@using AssetManagement.Application.Interfaces.Agent
@using AssetManagement.Domain.Enums.Assets
@using AssetManagement.Domain.Enums.Assignments
@using AssetManagement.Domain.Enums.Employees
@using Microsoft.AspNetCore.Components.Forms

@inject NavigationManager Navigation
@inject IAssetService AssetService
<h2>Create Asset</h2>
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

<EditForm Model="NewAsset" OnValidSubmit="SaveAsset" FormName="CreateAsset">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label for="fullName" class="form-label">
            Asset Name <span class="text-danger">*</span>
        </label>

        <InputText id="fullName" class="form-control" @bind-Value="NewAsset.AssetName" placeholder="Enter asset name" />
        <ValidationMessage For="@(() => NewAsset.AssetName)" />
    </div>

    <div class="mb-3">
        <label for="serialNumber" class="form-label">
            Serial Number <span class="text-danger">*</span>
        </label>

        <InputText id="serialNumber" class="form-control" @bind-Value="NewAsset.SerialNumber"
                   placeholder="Enter serial number" />
        <ValidationMessage For="@(() => NewAsset.SerialNumber)" />
    </div>

    <div class="mb-3">
        <label for="assetType" class="form-label">
            Asset Type <span class="text-danger">*</span>
        </label>

        <InputSelect id="assetType" class="form-select" @bind-Value="NewAsset.Type">

            <option value="">-- Select Asset Type --</option>

            @foreach (AssetType type in Enum.GetValues<AssetType>())
            {
                <option value="@type">
                    @type
                </option>
            }

        </InputSelect>
        <ValidationMessage For="@(() => NewAsset.Type)" />
    </div>

    <div class="mb-3">
        <label>Purchase Date</label>
        <InputDate @bind-Value="NewAsset.PurchaseDate" TValue="DateOnly" class="form-control" min="2010-01-01"
                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />
    </div>

    <div class="mb-3">
        <label>Warranty Expiry Date</label>
        <InputDate @bind-Value="NewAsset.WarrantyExpiryDate" TValue="DateOnly" class="form-control" min="2010-01-01"
                   max="2040-12-31" />
    </div>

    <div class="mb-3">
        <label for="assetCondition" class="form-label">
            Asset Condition <span class="text-danger">*</span>
        </label>

        <InputSelect id="assetCondition" class="form-select" @bind-Value="NewAsset.Condition">

            <option value="">-- Select Asset Condition --</option>

            @foreach (AssetCondition condition in Enum.GetValues<AssetCondition>())
            {
                <option value="@condition">
                    @condition
                </option>
            }

        </InputSelect>
        <ValidationMessage For="@(() => NewAsset.Condition)" />
    </div>

        <button type="submit" class="btn btn-primary" disabled="@_saving">
            Save
        </button>
</EditForm>

@code {
    private string ErrorMessage { get; set; } = string.Empty;
    private bool _saving;
    private Asset NewAsset = new Asset
    {
        PurchaseDate = DateOnly.FromDateTime(DateTime.Today),
        WarrantyExpiryDate = DateOnly.FromDateTime(DateTime.Today.AddYears(value: 3))
    };

    private async Task SaveAsset()
    {
        if (_saving) return;
        _saving = true;
        ErrorMessage = string.Empty;
        if (NewAsset.WarrantyExpiryDate < NewAsset.PurchaseDate)
        {
            ErrorMessage = "Warranty expiry date must be on or after the purchase date.";
            _saving = false;
            return;
        }
        try
        {
            await AssetService.CreateAssetAsync(NewAsset);
            Navigation.NavigateTo(uri: "/assets");
        }
        catch (Exception)
        {
            ErrorMessage = "An error occurred while creating the asset. Please try again.";
        }
        finally
        {
            _saving = false;
        }
    }
}

